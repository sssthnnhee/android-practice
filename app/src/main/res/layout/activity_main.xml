<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E0CE87"
    android:columnCount="3"
    android:paddingStart="0dp"
    android:paddingTop="25dp"
    android:paddingEnd="0dp"
    android:paddingBottom="25dp"
    android:rowCount="4">

    <TextView
        android:id="@+id/guideText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_column="0"
        android:layout_columnSpan="3"
        android:layout_row="0"
        android:gravity="center"
        android:padding="8dp"
        android:text="크게 볼 사진을 클릭해주세요."
        android:textSize="24sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/imageButton1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="0"
        android:layout_columnWeight="1"
        android:layout_row="1"
        android:layout_rowWeight="1"
        android:background="@android:color/transparent"
        android:contentDescription="첫 번째 사진 울먹 치이카와"
        android:scaleType="centerCrop"
        android:src="@drawable/imgbtn1" />

    <ImageButton
        android:id="@+id/imageButton2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="1"
        android:layout_columnWeight="1"
        android:layout_row="1"
        android:layout_rowWeight="1"
        android:background="@android:color/transparent"
        android:contentDescription="두 번째 사진 신도우 히카루"
        android:scaleType="centerCrop"
        android:src="@drawable/imgbtn2" />

    <ImageButton
        android:id="@+id/imageButton3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="2"
        android:layout_columnWeight="1"
        android:layout_row="1"
        android:layout_rowWeight="1"
        android:background="@android:color/transparent"
        android:contentDescription="세 번째 사진 해탈한 프로도"
        android:scaleType="centerCrop"
        android:src="@drawable/imgbtn3" />

    <ImageButton
        android:id="@+id/imageButton4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="0"
        android:layout_columnWeight="1"
        android:layout_row="2"
        android:layout_rowWeight="1"
        android:background="@android:color/transparent"
        android:contentDescription="네 번째 사진 똥 치이카와"
        android:scaleType="centerCrop"
        android:src="@drawable/imgbtn4" />

    <ImageButton
        android:id="@+id/imageButton5"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="1"
        android:layout_columnWeight="1"
        android:layout_row="2"
        android:layout_rowWeight="1"
        android:background="@android:color/transparent"
        android:contentDescription="다섯 번째 사진 토우야 아키라"
        android:scaleType="centerCrop"
        android:src="@drawable/imgbtn5" />

    <ImageButton
        android:id="@+id/imageButton6"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="2"
        android:layout_columnWeight="1"
        android:layout_row="2"
        android:layout_rowWeight="1"
        android:background="@android:color/transparent"
        android:contentDescription="여섯 번째 사진 무지와 콘"
        android:scaleType="centerCrop"
        android:src="@drawable/imgbtn6" />

    <ImageView
        android:id="@+id/largeImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="0"
        android:layout_columnSpan="3"
        android:layout_columnWeight="3"
        android:layout_row="3"
        android:layout_rowWeight="3"
        android:layout_gravity="fill"
        android:background="@android:color/transparent"
        android:contentDescription="선택되어 확대된 사진"
        android:scaleType="centerCrop"
        android:src="@drawable/imgbtn1" />

</GridLayout>
